word moveMask()
{

  #define INIT_STATE B11000000
  static uint8_t mask = INIT_STATE;
  static uint8_t callCounter = B10000000;
  uint16_t onoffTubeMask;

  if (callCounter == B000010)
  {
    callCounter = B10000000;
    mask = mask >> 2;
    if (mask == B00000011) mask = INIT_STATE;
  }
 
  if ((mask & callCounter) == 0) onoffTubeMask = TubeOFF;
    else onoffTubeMask = TubeON;
  
  callCounter = callCounter >> 1;
  return onoffTubeMask;
}

void SPI_Init() {
  pinMode(RHV5222PIN, INPUT_PULLUP);
  HV5222 = !digitalRead(RHV5222PIN);
  SPI.begin();  //
  if (HV5222)
    SPI.beginTransaction(SPISettings(2000000, LSBFIRST, SPI_MODE2));
  else SPI.beginTransaction(SPISettings(2000000, MSBFIRST, SPI_MODE2));
}

// AIR WERK discrete RGB pins, software PWM on Timer5 (Timer4 is reserved
// for the original Nixie SPI refresh). 32 steps x 4 kHz = 125 Hz PWM.
// Timer5 must not be used by another library or feature.
const byte AW_RED_PIN = 9, AW_GREEN_PIN = 6, AW_BLUE_PIN = 3;
volatile uint8_t awPWM[3] = {0,0,0};
ISR(TIMER5_COMPA_vect) {
  static uint8_t phase = 0;
  phase = (phase + 1) & 31;
  // Direct PORT writes for minimal interrupt overhead on Mega2560:
  // D9 = PH6, D6 = PH3, D3 = PE5.
  if (phase < awPWM[0]) PORTH |= _BV(PH6); else PORTH &= ~_BV(PH6);
  if (phase < awPWM[1]) PORTH |= _BV(PH3); else PORTH &= ~_BV(PH3);
  if (phase < awPWM[2]) PORTE |= _BV(PE5); else PORTE &= ~_BV(PE5);
}
void awApplyColor() {
  const uint8_t colors[6][3] = {
    {255,105,0}, {255,0,0}, {0,255,0},
    {0,0,255}, {255,255,255}, {160,0,255}
  };
  if (!awCustomColor) memcpy(awRGB, colors[awColor], 3);
  uint8_t levels[3];
  for (uint8_t i=0;i<3;i++) {
    uint32_t scaled = (uint32_t)awRGB[i] * awBrightness * 32UL;
    levels[i] = awLedEnabled ? (uint8_t)((scaled + 12750UL)/25500UL) : 0;
  }
  noInterrupts();
  memcpy((void*)awPWM, levels, 3);
  interrupts();
}
void LEDsSetup() {
  pinMode(AW_RED_PIN,OUTPUT); pinMode(AW_GREEN_PIN,OUTPUT); pinMode(AW_BLUE_PIN,OUTPUT);
  digitalWrite(AW_RED_PIN,LOW);digitalWrite(AW_GREEN_PIN,LOW);digitalWrite(AW_BLUE_PIN,LOW);
  awApplyColor();
  // 16MHz / 8 / (499+1) = 4kHz interrupts.
  TCCR5A=0; TCCR5B=0; TCNT5=0; OCR5A=499;
  TCCR5B=_BV(WGM52)|_BV(CS51);
  TIMSK5 |= _BV(OCIE5A);
}
