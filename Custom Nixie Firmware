    {
      isRunning = false;
      TurnOffLEDs();
    } else 
      {
        TurnOnLEDs();
      }
  }

  if ((OffState == true) && (setButton.clicks == 0)) 
  {
    return;
  } else if (setButton.clicks > 0) 
    {
      awBeep(1000, 100);
      TurnOnLEDs();
      if (OffState == true) setButton.clicks = 0;
      OffState = false;
    }

  if ((setButton.clicks < 0) || (MenuButtonState == 1) || (ModeButtonState == 1)) { //long click
    //editMode=true;
    awBeep(1000, 100);
    editMode = !editMode;
    if (editMode == true)
        EnterToEditMode();
      else 
        ExitFromEditMode();
  }

