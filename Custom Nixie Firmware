  TCNT4 = 0;  //reset counter to 0
  //OCR4A = 46; //3mS //More Noise ~-70dB 6khz, 12 khz
  OCR4A = 30;              // ~2ms refresh (about 504Hz), reduces dimming flicker
  TIMSK4 = (1 << OCIE1A);  //TIMER3_COMPA_vect interrupt enable
  sei();
}
