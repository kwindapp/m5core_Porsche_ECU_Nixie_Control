// AIR WERK RGB: short UP/DOWN cycles colors; hold UP=ON, DOWN=OFF.
// Handle raw button edges in all modes. In RTC edit mode the buttons
// retain their time-setting function. No PWM, preserving Timer4 refresh.
void airWerkBacklightButtons() {
  static bool prevUp = false, prevDown = false;
  static unsigned long upStart = 0, downStart = 0;
  static bool upLong = false, downLong = false;
  static unsigned long chordStart = 0;
  static bool chordDone = false;
  unsigned long now = millis();
  bool up = digitalRead(pinUp) == LOW;
  bool down = digitalRead(pinDown) == LOW;
  // Do not steal UP/DOWN presses while editing RTC time or timer values.
  bool editing = (airMode == AIR_CLOCK && clockEdit != 0) ||
                 (airMode == AIR_TIMER && editMode);
  // Hold UP + DOWN together for 2 seconds: cycle brightness 10..100%.
  // Suppress individual long/short actions during this chord.
  if (up && down && !editing) {
    if (!(prevUp && prevDown)) {chordStart=now;chordDone=false;}
    if (!chordDone && now-chordStart>=2000UL) {
      awBrightness = (awBrightness >= 100) ? 10 : (uint8_t)(((awBrightness/10)+1)*10);
      awLedEnabled=true;awApplyColor();chordDone=true;
      Serial.print(F("AIR WERK brightness "));Serial.println(awBrightness);
    }
    upLong=true;downLong=true;prevUp=up;prevDown=down;
    return;
  }
  if (up && !prevUp) { upStart = now; upLong = false; }
  if (down && !prevDown) { downStart = now; downLong = false; }
  if (up && !upLong && now-upStart >= 2000UL) {
    upLong = true;
    if (!editing) { awLedEnabled = true; awApplyColor(); Serial.println(F("AIR WERK RGB ON")); }
  }
  if (down && !downLong && now-downStart >= 2000UL) {
    downLong = true;
    if (!editing) { awLedEnabled = false; awApplyColor(); Serial.println(F("AIR WERK RGB OFF")); }
  }
  if (!up && prevUp && !upLong && now-upStart >= 35UL && !editing) {
    awColor = (awColor + 1) % AW_COLOR_COUNT; awCustomColor = false;
    awLedEnabled = true; awApplyColor();
    Serial.print(F("AIR WERK RGB color ")); Serial.println(awColor);
  }
  if (!down && prevDown && !downLong && now-downStart >= 35UL && !editing) {
    awColor = (awColor + AW_COLOR_COUNT - 1) % AW_COLOR_COUNT; awCustomColor = false;
    awLedEnabled = true; awApplyColor();
    Serial.print(F("AIR WERK RGB color ")); Serial.println(awColor);
  }
  prevUp = up; prevDown = down;
}

void loop() 
{
  airWerkBacklightButtons();
  airWerkReadUART();
  if (airStartupActive) { airWerkStartupLoop(); return; }
  if (airMode == AIR_EXTERNAL) return; // Timer cannot overwrite ESP32 digits.
  if (airMode == AIR_CLOCK) {airWerkClockLoop();return;}

#if defined(__AVR_ATmega1280__) || defined(__AVR_ATmega2560__)
  IRresults.value = 0;
  if (irrecv.decode(&IRresults)) {
    //Serial.println(IRresults.value, HEX); // debug
    irrecv.resume(); // Receive the next value
  }

  ModeButtonState = IRModeButton.checkButtonState(IRresults.value);
  if (ModeButtonState == 1) Serial.println(F("Mode short"));
  if (ModeButtonState == -1) Serial.println(F("Mode long...."));

  MenuButtonState = IRMenuButton.checkButtonState(IRresults.value);
  if (MenuButtonState == 1) Serial.println(F("Menu short"));
  if (MenuButtonState == -1) Serial.println(F("Menu long...."));

  UpButtonState = IRUpButton.checkButtonState(IRresults.value);
  if (UpButtonState == 1) Serial.println(F("Up short"));
  if (UpButtonState == -1) Serial.println(F("Up long...."));

  DownButtonState = IRDownButton.checkButtonState(IRresults.value);
  if (DownButtonState == 1) Serial.println(F("Down short"));
