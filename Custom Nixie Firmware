// AIR WERK startup: all six tubes count 0..9 TWICE,
// then show 911 on the first three and 930 on the last three for 20 seconds.
// Finally resume the independent RTC clock. UART may interrupt at any time.
bool airStartupActive = true;
uint8_t airStartupStep = 0;
unsigned long airStartupStepAt = 0;
const uint16_t AIR_STARTUP_DIGIT_MS = 180;
const unsigned long AIR_STARTUP_HOLD_MS = 20000UL;

void airWerkStartupLoop() {
  if (!airStartupActive) return;
  unsigned long now = millis();
  unsigned long duration = (airStartupStep < 20) ? AIR_STARTUP_DIGIT_MS : AIR_STARTUP_HOLD_MS;
  if (now - airStartupStepAt < duration) return;
  airStartupStepAt = now;
  ++airStartupStep;
  blinkMask = 0;
  LD = UD = false;
  if (airStartupStep < 20) {
    char digits[7];
    char value = '0' + (airStartupStep % 10);
    for (uint8_t i = 0; i < 6; ++i) digits[i] = value;
    digits[6] = '\0';
    stringToDisplay = digits;
  } else if (airStartupStep == 20) {
    stringToDisplay = "911930";
  } else {
    airStartupActive = false;
    rtcOK = readRTC();
    displayClock();
  }
}

uint8_t bcdToDecAW(uint8_t v) { return (v >> 4) * 10 + (v & 15); }
uint8_t decToBcdAW(uint8_t v) { return (v / 10) * 16 + (v % 10); }

bool readRTC() {
  Wire.beginTransmission(0x68);
  Wire.write((uint8_t)0);
  if (Wire.endTransmission() != 0) return false;
  if (Wire.requestFrom((uint8_t)0x68, (uint8_t)3) != 3) return false;
  uint8_t s = Wire.read(), m = Wire.read(), h = Wire.read();
  if (h & 0x40) { // RTC configured for 12-hour mode
    uint8_t hr = bcdToDecAW(h & 0x1f);
    rtcH = (hr % 12) + ((h & 0x20) ? 12 : 0);
  } else rtcH = bcdToDecAW(h & 0x3f);
  rtcM = bcdToDecAW(m & 0x7f);
  rtcS = bcdToDecAW(s & 0x7f);
  return rtcH < 24 && rtcM < 60 && rtcS < 60;
}

bool writeRTCTime() {
  Wire.beginTransmission(0x68);
  Wire.write((uint8_t)0);
  Wire.write(decToBcdAW(rtcS)); // CH=0 starts oscillator on DS1307
  Wire.write(decToBcdAW(rtcM));
  Wire.write(decToBcdAW(rtcH)); // 24-hour mode
  return Wire.endTransmission() == 0;
}

void displayClock() {
  if (!rtcOK) { stringToDisplay = "000000"; return; }
  char digits[7];
  snprintf(digits, sizeof(digits), "%02u%02u%02u", rtcH, rtcM, rtcS);
  stringToDisplay = digits;
  blinkMask = 0;
  LD = UD = (millis() / 500) % 2 == 0;
}

