// LED command parser. Replies go to Mega USB serial at 115200.
void awHandleLED(const char* cmd) {
  if (!strcmp(cmd,"LED:ON")) {awLedEnabled=true;awApplyColor();}
  else if (!strcmp(cmd,"LED:OFF")) {awLedEnabled=false;awApplyColor();}
  else if (!strncmp(cmd,"LED:BRIGHT:",11)) {
    const char* n=cmd+11; char* e;
    long v=strtol(n,&e,10);
    if (*n && !*e && v>=0 && v<=100) {awBrightness=(uint8_t)v;awApplyColor();}
    else {Serial.println(F("ERR LED BRIGHT 0..100"));return;}
  } else if (!strncmp(cmd,"LED:COLOR:",10)) {
    const char* n=cmd+10; char* e;
    long v=strtol(n,&e,10);
    if (*n && !*e && v>=0 && v<AW_COLOR_COUNT) {
      awColor=(uint8_t)v;awCustomColor=false;awLedEnabled=true;awApplyColor();
    } else {Serial.println(F("ERR LED COLOR 0..5"));return;}
  } else if (!strncmp(cmd,"LED:RGB:",8)) {
    int r=-1,g=-1,b=-1; char extra;
    if (sscanf(cmd+8,"%d,%d,%d%c",&r,&g,&b,&extra)==3 &&
        r>=0&&r<=255&&g>=0&&g<=255&&b>=0&&b<=255) {
      awRGB[0]=r;awRGB[1]=g;awRGB[2]=b;
      awCustomColor=true;awLedEnabled=true;awApplyColor();
    } else {Serial.println(F("ERR LED RGB r,g,b 0..255"));return;}
  } else if (strcmp(cmd,"LED:STATUS")) {Serial.println(F("ERR UNKNOWN LED COMMAND"));return;}
  Serial1.print(F("LED enabled="));Serial1.print(awLedEnabled);Serial1.print(F(" brightness="));Serial1.println(awBrightness);
  Serial.print(F("LED enabled="));Serial.print(awLedEnabled);
  Serial.print(F(" brightness="));Serial.print(awBrightness);
  Serial.print(F(" color="));Serial.print(awColor);
  Serial.print(F(" rgb="));Serial.print(awRGB[0]);Serial.print(',');
  Serial.print(awRGB[1]);Serial.print(',');Serial.println(awRGB[2]);
}

void airWerkReadUART() {
  static char line[64];
  static uint8_t len = 0;
  while (Serial1.available()) {
    char c = (char)Serial1.read();
    if (c == '\r') continue;
    if (c == '\n') {
      line[len] = 0;
      if (strncmp(line,"LED:",4)==0) {
        awHandleLED(line);
      } else if (!strcmp(line,"PING")) {
        awReply("PONG AIR_WERK_MEGA");
      } else if (!strcmp(line,"BUZZ:ON")) {
        awBuzzerEnabled = true; awReply("OK BUZZ ON");
      } else if (!strcmp(line,"BUZZ:OFF")) {
        awBuzzerEnabled = false; tone1.stop(); awReply("OK BUZZ OFF");
      } else if (!strcmp(line,"BUZZ:BEEP")) {
        awBeep(1200, 120); awReply(awBuzzerEnabled ? "OK BUZZ BEEP" : "OK BUZZ MUTED");
      } else if (!strcmp(line,"BUZZ:STATUS")) {
        awReply(awBuzzerEnabled ? "BUZZ ON" : "BUZZ OFF");
      } else if (!strncmp(line,"BUZZ:TONE:",10)) {
        unsigned int hz=0, duration=0; char tail=0;
        if (sscanf(line+10,"%u,%u%c",&hz,&duration,&tail)==2 && hz>=100 && hz<=5000 && duration>=20 && duration<=2000) {
          awBeep(hz,duration); awReply("OK BUZZ TONE");
        } else awReply("ERR BUZZ TONE hz,ms");
      } else if (!strcmp(line,"NIXIE:STATUS")) {
        awReply(String("NIXIE BRIGHTNESS ") + awNixieBrightness);
      } else if (!strncmp(line,"NIXIE:BRIGHT:",13)) {
        const char* n = line + 13;
        char* endPtr;
        long v = strtol(n, &endPtr, 10);
        if (*n && *endPtr == '\0' && v >= 0 && v <= 100) {
          awNixieBrightness = (uint8_t)v;
          Serial.print(F("NIXIE BRIGHTNESS "));
          Serial.println(v);
          Serial1.print(F("OK NIXIE BRIGHTNESS ")); Serial1.println(v);
        } else {
          awReply("ERR NIXIE BRIGHT 0..100");
        }
      } else if (len == 14 && strncmp(line, "DISPLAY:", 8) == 0) {
        bool valid = true;
        for (uint8_t i=8; i<14; ++i) if (line[i]<'0' || line[i]>'9') valid=false;
        if (valid) {
          memcpy(airWerkDigits, line+8, 6); airWerkDigits[6]=0;
          airStartupActive=false; airMode = AIR_EXTERNAL; clockEdit=0; editMode=false;
          isRunning=false; OffState=false; blinkMask=0; LD=UD=false;
          stringToDisplay = airWerkDigits;
          Serial.print(F("AIR WERK DISPLAY: ")); Serial.println(airWerkDigits);
        }
      } else if (strcmp(line,"MODE:CLOCK")==0) {
        airStartupActive=false; airMode=AIR_CLOCK; clockEdit=0; editMode=false; isRunning=false;
        rtcOK=readRTC(); displayClock();
        Serial.println(F("AIR WERK RTC CLOCK"));
      } else if (strcmp(line,"MODE:TIMER")==0) {
        airStartupActive=false; airMode=AIR_TIMER; clockEdit=0; isRunning=false;
        updateTubes(); Serial.println(F("AIR WERK TIMER"));
      } else if (!strcmp(line,"TIMER:START")) {
        airStartupActive=false;airMode=AIR_TIMER;isRunning=true;prevTickTime=millis();
        Serial.println(F("TIMER START"));
      } else if (!strcmp(line,"TIMER:PAUSE")) {
        isRunning=false;Serial.println(F("TIMER PAUSE"));
      } else if (!strcmp(line,"TIMER:RESET")) {
        isRunning=false;counter=counterStartValue;updateTubes();Serial.println(F("TIMER RESET"));
      } else if (len==15 && !strncmp(line,"SETTIMER:",9)) {
        bool valid=true;
        for(uint8_t i=9;i<15;i++) if(line[i]<'0'||line[i]>'9')valid=false;
        if(valid) {
          unsigned long h=(line[9]-'0')*10UL+line[10]-'0';
          unsigned long m=(line[11]-'0')*10UL+line[12]-'0';
          unsigned long sec=(line[13]-'0')*10UL+line[14]-'0';
          if(m<60&&sec<60) {
            counterStartValue=counter=(int32_t)(h*3600UL+m*60UL+sec);
            isRunning=false;if(airMode==AIR_TIMER)updateTubes();
            Serial.println(F("TIMER SET"));
          }
        }
      } else if (!strcmp(line,"STARTUP:PLAY")) {
        airMode=AIR_CLOCK;airStartupActive=true;airStartupStep=0;
        airStartupStepAt=millis();stringToDisplay="000000";
        Serial.println(F("STARTUP PLAY"));
      } else if (strncmp(line,"SETTIME:",8)==0 && len==14) {
        bool valid=true;
        for(uint8_t i=8;i<14;++i) if(line[i]<'0'||line[i]>'9') valid=false;
        if(valid) {
          uint8_t h=(line[8]-'0')*10+line[9]-'0';
          uint8_t m=(line[10]-'0')*10+line[11]-'0';
          uint8_t sec=(line[12]-'0')*10+line[13]-'0';
          if(h<24 && m<60 && sec<60) {
            rtcH=h;rtcM=m;rtcS=sec;rtcOK=writeRTCTime();
            if(airMode==AIR_CLOCK) displayClock();
            Serial.println(rtcOK?F("RTC TIME SET"):F("RTC WRITE FAILED"));
          }
        }
      }
      len=0;
    } else if (len<sizeof(line)-1) line[len++]=c;
    else len=0;
  }
}

void airWerkClockLoop() {
  setButton.Update(); upButton.Update(); downButton.Update();
  if (setButton.clicks < 0) { // long SET enters/leaves time setting
    if (clockEdit == 0) {rtcOK=readRTC();clockEdit=1;}
    else {clockEdit=0;rtcS=0;rtcOK=writeRTCTime();}
  } else if (setButton.clicks > 0 && clockEdit) {
    if (clockEdit == 1) clockEdit=2;
    else {clockEdit=0;rtcS=0;rtcOK=writeRTCTime();}
  }
  if (clockEdit) {
    int change=(upButton.clicks>0?1:0)-(downButton.clicks>0?1:0);
    if(change) {
      if(clockEdit==1) rtcH=(rtcH+24+change)%24;
      else rtcM=(rtcM+60+change)%60;
    }
  } else if (millis()-lastRTCRead>=200) {
    lastRTCRead=millis();rtcOK=readRTC();
  }
  displayClock();
  if(clockEdit) {
    // Blink the selected pair using the original driver's blink mask.
    blinkMask=(clockEdit==1?B00000011:B00001100);
  }
}

